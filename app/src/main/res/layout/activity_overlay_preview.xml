<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ca_bg"
    android:padding="20dp">

    <TextView
        style="@style/TextAppearance.CaptionAction.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/overlay_preview"
        android:textSize="26sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/resize_hint"
        android:textColor="@color/ca_muted" />

    <Spinner
        android:id="@+id/fontSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_cyan"
        android:padding="10dp" />

    <FrameLayout
        android:id="@+id/previewArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_lavender" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSavePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Save overlay layout" />
</LinearLayout>
