<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ca_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/permStepLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_cyan"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/ca_text"
        android:textStyle="bold"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/ca_card_pink"
        app:cardCornerRadius="28dp"
        app:cardElevation="3dp"
        app:strokeColor="#FFB6D9"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/permTitle"
                style="@style/TextAppearance.CaptionAction.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/permBody"
                style="@style/TextAppearance.CaptionAction.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/permHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ca_muted"
                android:textSize="13sp"
                android:text="One permission at a time — no popup pile-ups." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPermPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPermSecondary"
        style="@style/Widget.CaptionAction.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPermCancel"
        style="@style/Widget.CaptionAction.Button.Soft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/back" />
</LinearLayout>
