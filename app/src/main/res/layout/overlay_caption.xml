<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Caption bubble -->
    <LinearLayout
        android:id="@+id/captionBubble"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_overlay_bubble"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/captionPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ca_overlay_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/captionSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#992D2140"
            android:textSize="14sp"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Resize handle (bottom-right of bubble) -->
    <View
        android:id="@+id/resizeHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_resize_handle"
        android:contentDescription="Resize" />

    <!-- Floating close (bottom center-ish of overlay chrome) -->
    <TextView
        android:id="@+id/btnCloseOverlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_close_fab"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/ca_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:contentDescription="@string/close_overlay"
        android:elevation="8dp" />
</FrameLayout>
