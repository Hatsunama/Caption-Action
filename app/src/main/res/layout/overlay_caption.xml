<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Caption bubble inset so the stop-dot sits OUTSIDE the bubble chrome -->
    <LinearLayout
        android:id="@+id/captionBubble"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_overlay_bubble"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/captionPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ca_overlay_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/captionSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#992D2140"
            android:textSize="14sp"
            android:maxLines="2"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Green stop/home dot — outside top-left corner of the bubble -->
    <View
        android:id="@+id/btnStopDot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        android:background="@drawable/bg_green_dot"
        android:contentDescription="@string/stop_dot_a11y"
        android:elevation="12dp" />

    <View
        android:id="@+id/resizeHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_resize_handle"
        android:contentDescription="@string/resize_a11y" />

    <TextView
        android:id="@+id/btnCloseOverlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_close_fab"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/ca_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:contentDescription="@string/close_overlay"
        android:elevation="8dp" />
</FrameLayout>
