<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ca_refract_charcoal">

    <!-- Locked live procedural Home background (never a video/image asset). -->
    <com.hatsunama.captionaction.ui.home.RefractBackgroundView
        android:id="@+id/refractBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_home_header"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/ca_primary_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tagline"
                    android:textColor="@color/ca_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/privacyBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="@string/privacy_promise"
                    android:textColor="@color/ca_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_lavender"
                android:padding="14dp"
                android:text="@string/home_status_ready"
                android:textColor="@color/ca_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_hub"
                android:textColor="@color/ca_on_refract_muted"
                android:textSize="13sp" />

            <!-- Languages section: small bubbles only (no solid card) so refract shows through -->
            <TextView
                style="@style/TextAppearance.CaptionAction.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/section_languages"
                android:textColor="@color/ca_on_refract"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bubble_pink"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/input_language"
                    android:textStyle="bold"
                    android:textColor="@color/ca_text"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_pink_soft"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:popupBackground="@color/ca_card_pink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_bubble_pink"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/target_language"
                    android:textStyle="bold"
                    android:textColor="@color/ca_text"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_pink_soft"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:popupBackground="@color/ca_card_pink" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_bubble_lavender"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="@string/dual_subtitles"
                    android:textColor="@color/ca_text" />

                <TextView
                    android:id="@+id/dualHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_cyan_soft"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/dual_unavailable_hint"
                    android:textColor="@color/ca_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Captions save section -->
            <TextView
                style="@style/TextAppearance.CaptionAction.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_captions"
                android:textColor="@color/ca_on_refract"
                android:textSize="20sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/ca_card_cyan"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#7EDCE2"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSaveSubtitles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_subtitles_to_file" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/save_subtitles_hint"
                        android:textColor="@color/ca_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Overlay section: font only (resize on live overlay) -->
            <TextView
                style="@style/TextAppearance.CaptionAction.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_overlay"
                android:textColor="@color/ca_on_refract"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bubble_lavender"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/overlay_preview_hint"
                    android:textColor="@color/ca_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_bubble_lavender"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/overlay_font"
                    android:textStyle="bold"
                    android:textColor="@color/ca_text"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/fontSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_lavender_soft"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:popupBackground="@color/ca_card_lavender" />

                <TextView
                    android:id="@+id/previewSample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_overlay_bubble"
                    android:padding="16dp"
                    android:text="@string/overlay_sample_text"
                    android:textColor="@color/ca_overlay_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveOverlay"
                    style="@style/Widget.CaptionAction.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/save" />
            </LinearLayout>

            <!-- Start Live + Hatsu: scroll with content (not sticky) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/product_pick_label"
                android:textColor="@color/ca_on_refract_muted"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartLive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/product_live_cta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/product_live_blurb"
                android:textColor="@color/ca_on_refract_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMicTranslator"
                style="@style/Widget.CaptionAction.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ca_on_refract"
                android:text="@string/mic_translator_cta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mic_translator_blurb"
                android:textColor="@color/ca_on_refract_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThankYou"
                style="@style/Widget.CaptionAction.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:textColor="@color/ca_on_refract"
                android:text="@string/open_thank_you" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
