    <string name="permission_projection_title">Capture sounds playing on device</string>
    <string name="permission_projection_why">Android’s screen-capture prompt lets Caption Action hear app playback (YouTube, games, media) — not your microphone as the product. Allow it so captions follow what is playing on screen.</string>
