<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <application android:label="Caption Muted Capture Probe" android:allowBackup="false" android:allowAudioPlaybackCapture="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".ProbeActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".ProbeService" android:exported="false" android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
